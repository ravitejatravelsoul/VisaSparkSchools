# VisaSparkSchools environment variables.
# Copy this file to .env.local and fill in only what you need.
# The app builds and runs fully in guest/demo mode with NONE of these set.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL used for metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (optional) — enables accounts and the tutor's atomic per-user
# quota. Progress sync tables/RLS exist but no application code reads or
# writes them yet, so progress still lives in localStorage even when signed
# in (see "Known limitations" in README.md). Leave unset to run in
# guest-only local/demo mode.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI tutor (optional) — leave AI_TUTOR_ENABLED unset/false to keep the tutor
# honestly disabled; all lessons, exercises, quizzes, and search still work.
# ---------------------------------------------------------------------------
# Server-side switch actually gating the /api/tutor route.
AI_TUTOR_ENABLED=false
# Client-side switch controlling whether the tutor UI renders at all.
# Keep this in sync with AI_TUTOR_ENABLED above.
NEXT_PUBLIC_AI_TUTOR_ENABLED=false

# Any OpenAI-compatible chat completions endpoint. Not hard-wired to one vendor.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Per-user daily question allowance for the tutor.
AI_DAILY_TUTOR_ALLOWANCE=30
