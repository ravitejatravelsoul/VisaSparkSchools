# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# generated at predev/build time from content/ -- never hand-edited, and
# committing it just creates diff noise on every content change
/public/search-index.json

# generated by `npm run content:check-links` -- a point-in-time network
# check, never hand-edited; committing a stale snapshot would be actively
# misleading, so this follows the same convention as search-index.json above
/reference-link-audit.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local link/session state -- may include a pooler connection
# string with embedded credentials; machine-local, never meaningful to commit
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
