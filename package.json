{
  "name": "visasparkschools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "scripts": {
    "predev": "npm run content:search-index",
    "dev": "next dev",
    "build": "npm run content:validate && npm run content:search-index && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "e2e": "playwright test",
    "e2e:auth-captcha": "playwright test --config=playwright.auth-captcha.config.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:search-index": "tsx scripts/build-search-index.ts",
    "content:ai-index": "tsx scripts/ai-ingest.ts",
    "content:validate-snippets": "tsx scripts/validate-snippets.ts",
    "content:interview-inventory": "tsx scripts/interview-prep-inventory.ts",
    "security:scan-client-secrets": "tsx scripts/scan-client-secrets.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "libphonenumber-js": "^1.13.10",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sql.js": "^1.14.1",
    "typescript": "^5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
